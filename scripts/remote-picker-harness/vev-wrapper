#!/bin/sh
set -eu

export XDG_STATE_HOME=/tmp/vev-state
export XDG_RUNTIME_DIR=/tmp/vev-runtime
export VEV_TEST_ENV=remote
export WAYLAND_DISPLAY=wayland-remote
export TERM=xterm-256color
export COLORTERM=truecolor


case "$*" in
  *remote-catalog*)
    if [ -e /tmp/vev-bad-catalog ]; then
      printf '%s\n' '{"protocol_version":23,"schema_version":1,"sessions":[]}'
      exit 0
    fi
    ;;
  *_remote-preview*)
    if [ -e /tmp/vev-slow-preview ]; then
      sleep 3
    fi
    ;;
esac

exec /usr/local/bin/vev.real "$@"
